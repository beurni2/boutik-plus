{
  "name": "@boutik/media-service",
  "version": "0.0.1",
  "private": true,
  "description": "Product media (BOUTIK-MEDIA-1): validate → store in private R2 → serve by opaque token.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json",
    "test": "vitest run",
    "bundle:worker": "esbuild worker/entry.ts --bundle --format=esm --outfile=dist/worker/worker.mjs --platform=neutral --conditions=import --define:__BOUTIK_RELEASE__=\"'${BOUTIK_RELEASE:-dev}'\" --define:__BOUTIK_CANON__=\"'${BOUTIK_CANON:-dev}'\"",
    "pretest": "pnpm bundle:worker"
  },
  "dependencies": {
    "@boutik/observability": "workspace:*",
    "@boutik/service-auth": "workspace:*",
    "@platform/contracts": "git+https://github.com/beurni2/platform-contracts.git#084678005579c530f44eff05385852c5181b60aa&path:packages/contracts"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@cloudflare/workers-types": "^4.20250705.0",
    "esbuild": "^0.25.5",
    "miniflare": "^4.20250705.0"
  }
}

{
  "name": "@boutik/offer-service",
  "version": "0.0.1",
  "private": true,
  "description": "Workers service stub (WO-B0.1): folder, types, health endpoint \u2014 no features.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p worker/tsconfig.json",
    "test": "vitest run",
    "bundle:worker": "esbuild worker/index.ts --bundle --format=esm --outfile=dist/worker/worker.mjs --platform=neutral --conditions=import --define:__BOUTIK_RELEASE__=\"'${BOUTIK_RELEASE:-dev}'\" --define:__BOUTIK_CANON__=\"'${BOUTIK_CANON:-dev}'\"",
    "pretest": "pnpm bundle:worker"
  },
  "dependencies": {
    "@boutik/observability": "workspace:*",
    "@boutik/service-auth": "workspace:*",
    "@platform/contracts": "git+https://github.com/beurni2/platform-contracts.git#95c71c33d212ec26fffe3e36b3ccc7fbc673a7c3&path:packages/contracts"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@platform/certification": "git+https://github.com/beurni2/platform-contracts.git#95c71c33d212ec26fffe3e36b3ccc7fbc673a7c3&path:packages/certification",
    "@cloudflare/workers-types": "^4.20250705.0",
    "esbuild": "^0.25.5",
    "miniflare": "^4.20250705.0",
    "zod": "^4.1.5",
    "@boutik/fulfillment-service": "workspace:*"
  }
}
